<div>
  <p style = "color: green;"><%= flash[:notice] %></p>
</div>

<h2>Editing Book</h2>
<% if @book.errors.any? %>
  <%= @book.errors.count %> 'errors prohibited this book form being saved:'
  <ul>
    <% @book.errors.full_messages.each do |message| %>
      <li><%= message %></li>
    <% end %>
  </ul>
<% end %>

<%= form_with model: @book, url: book_path(@book.id), method: :patch do |f| %>

  <div class="edit-post">
    <p>Title</p>
    <%= f.text_field :title , class: "edit-input-title" %>
  
    <p>Body</p>
    <%= f.text_area :body , class: "edit-input-body" %>
  </div>

  <div>
    <%= f.submit 'Update Book', class: "submit-btn" %>
  </div>
<% end %>

<%= link_to "Show", book_path(book.id), style: "color:black;" %>
<span> | </span>
<%= link_to "Back", books_path , style: "color:black;" %>