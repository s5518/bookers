<h1>Books</h1>

<% @books.each do |book| %>
  <p>Title</p>
  <span>
    <%= link_to book.title, book_path(book.id) %>
  </span>

  <p>Body</p>
  <span>
    <%= link_to book.body, book_path(book.id) %>
  </span>  
  
<%end%>

<h3>New book</h3>
<% if @book.errors.any? %>
  <%= @book.errors.count %> errors prohibited this book form being saved:
  <ul>
    <% @book.errors.full_messages.each do |message| %>
      <li><%= message %></li>
    <% end %>
  </ul>
<% end %>

<%= form_with model: @book do |f| %>

    <h6>Title</h6>
    <%= f.text_field :title %>

    <h6>Body</h6>
    <%= f.text_area :body %>

  <div>      
    <%= f.submit 'Create Book' %>
  </div>
<% end %>